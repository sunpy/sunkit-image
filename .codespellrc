[codespell]
skip =
    *.asdf,
    *.fits,
    *.fts,
    *.header,
    *.json,
    *.xsh,
    *cache*,
    *egg*,
    *extern*,
    .git,
    .idea,
    .tox,
    _build,
    *truncated,
    *.svg,
    .asv_env,
    .history,

ignore-words-list =
    ANDed,
    arange,
    iy,
    EIS,
    eis,
    EIT,
    eit,
    NDCube,
    RHE,
    rhe,
    BA,
    ba,
    nin,
